# Compose binds the host port to 127.0.0.1. A nonempty token is required inside
# Docker because the app must listen on the container's 0.0.0.0 interface.
# Choose a long random value and enter it here before `docker compose up`.
APP_AUTH_TOKEN=
DATA_DIR=./data
PORT=8080
HOST=127.0.0.1

# Default model uses official Codex CLI with the user's ChatGPT account.
# Complete a fresh official device login in the web control panel.
# Existing subscription limits apply. No paid API fallback is enabled.

# Optional private S3-compatible off-host snapshots.
# Oracle local disk is persistent; verify object-storage free limits first.
# Cloudflare Containers is inactive under the zero-cost requirement.
# Native R2 Worker snapshots are an alternative without S3 API keys:
BACKUP_ENDPOINT=
BACKUP_HTTP_TOKEN=
S3_ENDPOINT=
S3_BUCKET=autonomous-assistant-data
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=assistant
BACKUP_INTERVAL_SECONDS=86400
REQUIRE_BACKUP=false
