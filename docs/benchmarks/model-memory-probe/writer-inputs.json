    "messages": [
      {
        "id": 201,
        "role": "user",
        "createdAt": "2025-01-10T09:00:00+09:00",
        "text": "2025년 1월 1일부터 내 작업실은 서울 마포구에 있어."
      },
      {
        "id": 202,
        "role": "user",
        "createdAt": "2026-04-10T09:00:00+09:00",
        "text": "작업실을 2026년 4월 1일에 부산 수영구로 옮겼어. 이전 마포구 기록은 과거 주소로 남겨."
      }
    ],
    "deviceEvents": [],
    "archiveCoverage": {
      "complete": true
    }
  },
  {
