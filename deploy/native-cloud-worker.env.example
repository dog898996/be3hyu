# Fixed Linux Cloud VM: the phone connects to this worker; it does not keep it alive.
# Copy into a PRIVATE deployment .env, then set APP_AUTH_TOKEN before Docker startup.
# This is a device connection key, not an application signup/account system.
APP_AUTH_TOKEN=

# Select the resident official Codex app-server engine.
ASSISTANT_ENGINE=codex-native

# Container paths: Compose mounts persistent storage at /data.
# For direct host npm start, replace BOTH paths with /opt/hoyoung/data and
# /opt/hoyoung/data/codex, or another existing persistent host directory.
DATA_DIR=/data
CODEX_HOME=/data/codex
PERSIST_CODEX_AUTH=true

# Direct host execution binds loopback behind HTTPS/VPN.
# Existing Compose explicitly overrides HOST to 0.0.0.0 inside the container,
# while exposing its port only on the host's 127.0.0.1.
HOST=127.0.0.1
PORT=8080

# Autonomy's 60-second interval is a saved application setting, not an env flag.
# Complete fresh official Codex subscription login on the deployed worker once.
# Do not copy development-machine credentials into the image or this file.

# Optional off-host backup. No storage purchase or API fallback is enabled here.
BACKUP_ENDPOINT=
BACKUP_HTTP_TOKEN=
S3_ENDPOINT=
S3_BUCKET=autonomous-assistant-data
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=assistant
BACKUP_INTERVAL_SECONDS=86400
REQUIRE_BACKUP=false
